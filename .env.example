# Runtime profile: standalone, server, or desktop.
JET_BLACK_PROFILE=standalone
JET_BLACK_BIND=127.0.0.1:4317
# Required when binding publicly; include scheme and authority.
JET_BLACK_PUBLIC_ORIGIN=http://127.0.0.1:4317
JET_BLACK_DATA_DIR=.jet-black
JET_BLACK_STATIC_ASSETS_DIR=apps/web/build-client

# Development seed only.
JET_BLACK_DEV_SEED=true
JET_BLACK_DEV_PASSWORD=jet-black-development

# Agent provider and optional model.
JET_BLACK_PROVIDER=mock
JET_BLACK_PROVIDER_MODEL=

# Colon-separated absolute repository roots on Linux/macOS.
JET_BLACK_REPOSITORY_ROOTS=

# Outbound worker daemon. These are used by `jet-black-worker`, not the server.
# JET_BLACK_CONTROL_PLANE=https://jet-black.example.com
# JET_BLACK_WORKER_TOKEN=
# JET_BLACK_WORKER_HANDLER=/absolute/path/to/jet-black-worker-handler
# JET_BLACK_WORKER_CAPABILITIES=git,agent
# JET_BLACK_WORKER_REPOSITORIES=repository-stable-identity
