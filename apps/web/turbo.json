{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["build-client/**"]
    },
    "test": {
      "outputs": ["test-results/**", "playwright-report/**"],
      "env": ["PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH"],
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD"
      ]
    }
  }
}
