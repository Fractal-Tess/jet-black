{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet-black.invalid/governance/provenance.schema.json",
  "title": "Jet Black reference provenance register",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "distributionReadiness", "notes", "references"],
  "properties": {
    "$schema": { "type": "string" },
    "status": { "const": "reference-inventory-only" },
    "distributionReadiness": { "const": false },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "repository",
          "revision",
          "license",
          "licenseEvidence",
          "use",
          "implementation_rule"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "format": "uri" },
          "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "license": { "type": "string", "minLength": 1 },
          "licenseEvidence": { "type": "string", "minLength": 1 },
          "use": { "type": "string", "minLength": 1 },
          "implementation_rule": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
