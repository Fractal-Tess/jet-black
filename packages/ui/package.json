{
  "name": "@workspace/ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "svelte-kit sync",
    "dev": "vite dev",
    "lint": "bunx ultracite check src svelte.config.js vite.config.ts",
    "prepare": "svelte-kit sync",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.53.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.25.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.53.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "bits-ui": "^2.16.3",
    "csstype": "^3.1.3",
    "layerchart": "2.0.0-next.48",
    "svelte-check": "^4.4.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.15"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./globals.css": "./src/app.css",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/lib/components/*/index.ts"
  }
